{"1":["              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">Abby&#8217;s Table is a trading name of <strong style=\"font-weight: 600; color: var(--green-forest);\">Abby&#8217;s Table Foods Ltd</strong>, a company registered in England and Wales.</p>","              <!-- PLACEHOLDER registration and contact details — the same stand-ins as Terms of Sale\n                   and Contact, so they are corrected in one pass. Logged in build-handoff.md. -->\n              <div class=\"at-t-info\" style=\"margin-top: 18px; background: var(--sand); border-radius: 14px; padding: 22px 24px;\">\n                <div>\n                  <p style=\"margin: 0; font-family: var(--font-sans); font-weight: 600; font-size: 16px; line-height: 1.4; color: var(--brown);\">Company number</p>\n                  <p style=\"margin: 3px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.3; color: var(--green-forest);\">12345678</p>\n                </div>\n                <div>\n                  <p style=\"margin: 0; font-family: var(--font-sans); font-weight: 600; font-size: 16px; line-height: 1.4; color: var(--brown);\">Registered office</p>\n                  <p style=\"margin: 3px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.3; color: var(--green-forest);\">1 Example Street<br />London<br />AB1 2CD</p>\n                </div>\n              </div>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">For data-protection purposes, <strong style=\"font-weight: 600; color: var(--green-forest);\">Abby&#8217;s Table Foods Ltd</strong> is responsible for the personal information described in this policy.</p>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">If you have a question about your personal information, you can contact us at:</p>","              <div class=\"at-t-info\" style=\"margin-top: 18px; background: var(--cream-2); border: 1px solid var(--sand); border-radius: 14px; padding: 20px 22px;\">\n                <div>\n                  <p style=\"margin: 0; font-family: var(--font-sans); font-weight: 600; font-size: 16px; line-height: 1.4; color: var(--brown);\">Email</p>\n                  <p style=\"margin: 3px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.3; color: var(--green-forest);\"><a class=\"at-tlink\" href=\"mailto:hello@FromAbbysTable.co.uk\" style=\"color: var(--green-forest); text-decoration: underline; text-underline-offset: 3px;\">hello@FromAbbysTable.co.uk</a></p>\n                </div>\n                <div>\n                  <p style=\"margin: 0; font-family: var(--font-sans); font-weight: 600; font-size: 16px; line-height: 1.4; color: var(--brown);\">Telephone</p>\n                  <p style=\"margin: 3px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.3; color: var(--green-forest);\"><a class=\"at-tlink\" href=\"tel:+442038751234\" style=\"color: var(--green-forest); text-decoration: underline; text-underline-offset: 3px;\">020 3875 1234</a></p>\n                </div>\n                <div>\n                  <p style=\"margin: 0; font-family: var(--font-sans); font-weight: 600; font-size: 16px; line-height: 1.4; color: var(--brown);\">Post</p>\n                  <p style=\"margin: 3px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.3; color: var(--green-forest);\">1 Example Street<br />London<br />AB1 2CD</p>\n                </div>\n              </div>"],"2":["              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">The information we collect depends on how you use Abby&#8217;s Table.</p>","              <h4 style=\"margin: 24px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.25; color: var(--green-forest);\">When you place an order or create an account</h4>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">We may collect:</p>","              <ul style=\"margin: 12px 0 0; padding-left: 22px;\">\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">your name;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">email address;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">telephone number;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">billing and delivery address;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">delivery instructions;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">account details;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">order history;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">dishes, quantities and portion choices;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">payment and refund status; and</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">credits, promotions or other account information.</li>\n              </ul>","              <h4 style=\"margin: 24px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.25; color: var(--green-forest);\">When you contact us</h4>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">We may collect:</p>","              <ul style=\"margin: 12px 0 0; padding-left: 22px;\">\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">your contact details;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">your order number;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">your message;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">our correspondence with you;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">complaint or customer-service information; and</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">images you choose to upload.</li>\n              </ul>","              <h4 style=\"margin: 24px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.25; color: var(--green-forest);\">When you use our website</h4>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">We may collect information such as:</p>","              <ul style=\"margin: 12px 0 0; padding-left: 22px;\">\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">IP address;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">browser and device information;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">account and security activity;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">website usage information;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">cookies and similar identifiers; and</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">analytics or advertising information where those technologies are used lawfully.</li>\n              </ul>","              <h4 style=\"margin: 24px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.25; color: var(--green-forest);\">If someone sends you a gift</h4>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">The person placing the order may provide us with information such as your:</p>","              <ul style=\"margin: 12px 0 0; padding-left: 22px;\">\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">name;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">delivery address;</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">telephone number; and</li>\n                <li style=\"margin-top: 6px; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">delivery instructions.</li>\n              </ul>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">We use this information to fulfil and support the gift order.</p>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">Receiving an Abby&#8217;s Table gift does <strong style=\"font-weight: 600; color: var(--green-forest);\">not</strong> automatically subscribe you to our marketing.</p>","              <h4 style=\"margin: 24px 0 0; font-family: var(--font-display); font-weight: var(--weight-medium); font-size: 19px; line-height: 1.25; color: var(--green-forest);\">Allergies and dietary information</h4>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">You may also choose to provide information about allergies, intolerances, dietary requirements or other health-related information where it is relevant to your order or enquiry.</p>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">We explain how we handle this more sensitive information in section 4.</p>"],"3":["              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">We only use personal information where we have a lawful reason to do so.</p>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">Typical uses include:</p>","              <dl class=\"at-p-pairs\" style=\"margin: 16px 0 0;\">\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Take and fulfil your order</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Contract</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Process payments and refunds</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Contract and/or legal obligations</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Arrange delivery</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Contract</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Manage your Abby&#8217;s Table account</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Contract</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Send order and delivery updates</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Contract</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Respond to enquiries and complaints</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Contract and/or legitimate interests</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Manage food safety, traceability and recalls</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Legal obligations and/or legitimate interests</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Keep tax and accounting records</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Legal obligation</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Prevent fraud and protect our website</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Legitimate interests</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Improve customer service and operations</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Legitimate interests</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Send marketing you have chosen to receive</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Consent or another lawful route where applicable</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Manage the Private Table waitlist</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Your request and/or consent</dd>\n                </div>\n                <div class=\"at-p-pair\">\n                  <dt style=\"font-family: var(--font-sans); font-size: 16px; line-height: 1.5; color: var(--green-forest);\">Use analytics or advertising technologies</dt>\n                  <dd class=\"at-p-pair-v\" style=\"margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.45; color: var(--brown);\"><span class=\"at-p-pair-k\" aria-hidden=\"true\">Our usual legal reason: </span>Consent where required</dd>\n                </div>\n              </dl>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">Where we rely on <strong style=\"font-weight: 600; color: var(--green-forest);\">legitimate interests</strong>, these may include protecting Abby&#8217;s Table and our customers from fraud, keeping our website secure, investigating service problems, improving our operations and protecting our legal rights.</p>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">Some information is necessary for us to provide a service. For example, we cannot normally deliver an order without your name, contact details and delivery address.</p>","              <p style=\"margin: 14px 0 0; font-family: var(--font-sans); font-size: 16px; line-height: 1.6; color: var(--brown); text-wrap: pretty;\">Where information is optional, we aim to make that clear when we ask for it.</p>"]}