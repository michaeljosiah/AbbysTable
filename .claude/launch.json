{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "abbys-table-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "abbys-table-attach",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "abbys-table-template",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "--directory",
        "docs/template"
      ],
      "port": 4180
    }
  ]
}
